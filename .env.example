# Copy to .env and edit. Every setting is optional; the defaults need no keys.

# Shared secret for every /v1 route and /metrics. Leave unset only on your own machine.
# RAGGITY_API_KEY=
# Keep vector matrices in memory between queries (set false to measure the uncached cost).
RAGGITY_VECTOR_CACHE=true

# hash | sentence-transformers | openai | ollama
RAGGITY_EMBEDDING_PROVIDER=hash
# RAGGITY_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# echo | anthropic | openai | ollama
RAGGITY_LLM_PROVIDER=echo
# RAGGITY_LLM_MODEL=claude-opus-5-5
# RAGGITY_LLM_EFFORT=medium

# none | cross-encoder | llm
RAGGITY_RERANKER=none

RAGGITY_CHUNKER=recursive
RAGGITY_CHUNK_SIZE=800
RAGGITY_CHUNK_OVERLAP=120
RAGGITY_DATA_DIR=data

# Provider credentials: read by the SDKs, never by Raggity's settings.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RAGGITY_OLLAMA_BASE_URL=http://localhost:11434
